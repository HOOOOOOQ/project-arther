local Schema = require("../src/ServerScriptService/Services/ProfileSchema")
local Rules = require("../src/ServerScriptService/Services/InventoryRules")
local profile = Schema.new()
local ok, result = Rules.consumeTonic(profile, 100, 100, 40)
assert(not ok and profile.inventory.tonic == 2)
ok, result = Rules.consumeTonic(profile, 75, 100, 40)
assert(ok and result == 100 and profile.inventory.tonic == 1)
ok, result = Rules.consumeTonic(profile, 0, 100, 40)
assert(not ok and profile.inventory.tonic == 1)
ok, result = Rules.consumeTonic(profile, 20, 100, 40)
assert(ok and result == 60 and profile.inventory.tonic == 0)
ok = Rules.consumeTonic(profile, 20, 100, 40)
assert(not ok and profile.inventory.tonic == 0)
assert(Schema.validate(profile))
print("PASS: inventory consumption")
